# CharPhone 示範環境變數範例
# 複製為 .env 後可覆寫 docker-compose.yaml 的預設值。
# 下列密碼僅供本機示範，請勿直接用於任何正式環境。
# 產生密碼：openssl rand -base64 24 | tr -dc 'A-Za-z0-9'

MYSQL_ROOT_PASSWORD=charphone_demo_root
DB_USER=charphone
DB_PASS=charphone_demo_app

# 僅在空資料庫第一次由 Flyway 建立 admin 時使用。
# 示範帳號：admin / demo1234
ADMIN_PASSWORD=demo1234

# DB 層唯讀帳號（供唯讀/暫時 session 使用）
DB_RO_USER=charphone_ro
DB_RO_PASS=charphone_demo_ro

# 對外網址（只填 origin，不要含 context path）
APP_BASE_URL=http://localhost:8080

# Token hash pepper（可留空；變更後所有既有 token 立即失效）
TOKEN_PEPPER=charphone_demo_pepper

# AI Gateway 示範 API Key（需與 enterprise-ai-gateway 的 data.sql 相同）
AI_GATEWAY_API_KEY=demo-api-key-charphone
